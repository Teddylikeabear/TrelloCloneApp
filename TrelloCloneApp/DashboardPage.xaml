<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="TrelloCloneApp.DashboardPage"
             BackgroundColor="Black"
             Shell.NavBarIsVisible="False"
             Title="DashboardPage">

    <Grid RowDefinitions="Auto, *">
        <!-- AppBar -->
        <Grid BackgroundColor="#222">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Label Text="Boards" FontSize="18" FontAttributes="Bold" TextColor="White" VerticalOptions="Center" Margin="10,0" />

            <HorizontalStackLayout Grid.Column="1" Spacing="15" VerticalOptions="Center">
                <Image Source="search_icon.png" HeightRequest="20" WidthRequest="20" />
                <Image Source="notification_icon.png" HeightRequest="20" WidthRequest="20" />
            </HorizontalStackLayout>
        </Grid>

        <!-- Main Content -->
        <Grid Grid.Row="1" ColumnDefinitions="*,*" RowDefinitions="*">
            <!-- Sidebar -->
            <VerticalStackLayout BackgroundColor="#333" Padding="10" Spacing="20">
                <!-- Profile Section -->
                <HorizontalStackLayout Spacing="10" VerticalOptions="StartAndExpand">
                    <Frame CornerRadius="25" HeightRequest="50" WidthRequest="50" BackgroundColor="#555">
                        <Label Text="TM" TextColor="White" HorizontalOptions="Center" VerticalOptions="Center" FontAttributes="Bold" FontSize="Large" />
                    </Frame>

                    <VerticalStackLayout>
                        <Label Text="Thendo Charmaine Marageni" FontSize="10" TextColor="White" />
                        <Label Text="nyatshiisana@gmail.com" FontSize="8" TextColor="#bbb" />
                    </VerticalStackLayout>
                </HorizontalStackLayout>

                <!-- Menu Items -->
                <VerticalStackLayout Spacing="15">
                    <HorizontalStackLayout Spacing="10">
                        <Image Source="boards_icon.png" HeightRequest="20" WidthRequest="20" />
                        <Button Text="Boards" TextColor="White" FontSize="12" BackgroundColor="Transparent"/>
                    </HorizontalStackLayout>

                    <HorizontalStackLayout Spacing="10">
                        <Image Source="trellologo.png" HeightRequest="20" WidthRequest="20" />
                        <Button Text="Trello Workspace" TextColor="White" FontSize="12" BackgroundColor="Transparent" />
                    </HorizontalStackLayout>

                    <HorizontalStackLayout Spacing="10">
                        <Image Source="cards_icon.png" HeightRequest="20" WidthRequest="20" />
                        <Button Text="My Cards" TextColor="White" FontSize="12" BackgroundColor="Transparent" Clicked="OnCardsClicked"/>
                    </HorizontalStackLayout>

                    <HorizontalStackLayout Spacing="10">
                        <Image Source="templates_icon.png" HeightRequest="20" WidthRequest="20" />
                        <Button Text="Browse Templates" TextColor="White" FontSize="12" BackgroundColor="Transparent" Clicked="OnTemplatesClicked" />
                    </HorizontalStackLayout>

                    <HorizontalStackLayout Spacing="10">
                        <Image Source="offline_icon.png" HeightRequest="20" WidthRequest="20" />
                        <Button Text="Offline Boards" TextColor="White" FontSize="12" BackgroundColor="Transparent" Clicked="OnOfflineBoardsClicked" />
                    </HorizontalStackLayout>

                    <HorizontalStackLayout Spacing="10">
                        <Image Source="settings_icon.png" HeightRequest="20" WidthRequest="20" />
                        <Button Text="Settings" TextColor="White" FontSize="12" BackgroundColor="Transparent" Clicked="OnSettingsClicked" />
                    </HorizontalStackLayout>

                    <HorizontalStackLayout Spacing="10">
                        <Image Source="help_icon.png" HeightRequest="20" WidthRequest="20" />
                        <Button Text="Help" TextColor="White" FontSize="12" BackgroundColor="Transparent" Clicked="OnHelpClicked" />
                    </HorizontalStackLayout>
                </VerticalStackLayout>
            </VerticalStackLayout>

            <!-- Main Panel -->
            <VerticalStackLayout Grid.Column="1" Padding="15" Spacing="20">
                <!-- Quick Add Section -->
                <Grid Padding="5" RowSpacing="5" ColumnSpacing="5">
                    <!-- Main Grid -->
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Quick Add Section -->
                    <Frame Grid.Row="0"
               CornerRadius="10" 
               BackgroundColor="#444" 
               Padding="15" 
               Margin="0,10,0,0">
                        <Grid RowSpacing="10">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!-- Title -->
                            <Label Grid.Row="0"
                       Text="Quick Add" 
                       TextColor="White" 
                       FontSize="8" 
                       FontAttributes="Bold" />

                            <!-- TaskConnect Section -->
                            <Frame Grid.Row="1" 
                       CornerRadius="5" 
                       Padding="5" 
                       BackgroundColor="#555">
                                <Label Text="TaskConnect
                                       To-Do" 
                           TextColor="White" 
                           FontSize="10" />

                            </Frame>

                            <!-- Add Card Button -->
                            <Button Grid.Row="2" 
                        Text="Add Card" 
                        BackgroundColor="#456DFF" 
                        TextColor="White" 
                        HeightRequest="40" 
                        CornerRadius="20" />
                        </Grid>
                    </Frame>
                </Grid>

                <!-- Workspaces -->
                <VerticalStackLayout>
                    <Label Text="Trello Workspace" TextColor="White" FontSize="14" FontAttributes="Bold" />

                    <Frame CornerRadius="5" Padding="5" BackgroundColor="#555" Margin="0,10">
                        <Label Text="Project Management" TextColor="White" FontSize="12" />
                    </Frame>

                    <Frame CornerRadius="5" Padding="5" BackgroundColor="#555">
                        <Label Text="TaskConnect" TextColor="White" FontSize="12" />
                    </Frame>
                </VerticalStackLayout>
            </VerticalStackLayout>
        </Grid>

        <!-- Floating Action Button -->
        <Button Text="+ Create Board" BackgroundColor="#8A5FDB" TextColor="White" WidthRequest="140" HeightRequest="50" CornerRadius="25" HorizontalOptions="End" VerticalOptions="End" Margin="15" />
    </Grid>



</ContentPage>